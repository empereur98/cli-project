import { defineNuxtModule, createResolver, addComponentsDir, addImportsDir, extendPages } from '@nuxt/kit'

export interface ModuleOptions {
  apiBaseUrl?: string
}

export default defineNuxtModule<ModuleOptions>({
  meta: {
    name: '{{MODULE_NAME}}',
    configKey: '{{CONFIG_KEY}}'
  },
  defaults: {
    apiBaseUrl: 'https://api.example.com'
  },
  setup(options, _nuxt) {
    const resolver = createResolver(import.meta.url)

    console.log('[{{MODULE_NAME}}] Feature module registered')

    // Auto-register components from ./components globally
    addComponentsDir({
      path: resolver.resolve('./components'),
      pathPrefix: false
    })

    // Auto-register composables, services, and stores
    addImportsDir([
      resolver.resolve('./composables'),
      resolver.resolve('./services'),
      resolver.resolve('./stores')
    ])

    // Wire module pages directly into the host Nuxt application router
    extendPages((pages) => {
      pages.push({
        name: '{{MODULE_NAME}}',
        path: '/{{MODULE_NAME}}',
        file: resolver.resolve('./pages/index.vue')
      })
    })
  }
})

